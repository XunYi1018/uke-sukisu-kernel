# Example: legacy Non-GKI kernel (Linux 4.19) with SUSFS and path_umount.
#
# Run it with:  Actions -> Build Kernel -> Config file to build =
#               config/nongki-4.19-susfs.env
#
# SukiSU-Ultra's `builtin` branch is used deliberately. susfs4ksu's non-GKI
# branches have not been updated since early 2025 and still target KernelSU's
# old flat source layout, so their KernelSU-side patch fails against forks that
# have since restructured. `builtin` ships SUSFS itself, so that patch is
# skipped entirely and the combination actually applies cleanly.

CONFIG_ENV=config/nongki-4.19-susfs.env

KERNEL_SOURCE=https://github.com/xiaoleGun/android_kernel_xiaomi_wayne-4.19
KERNEL_SOURCE_BRANCH=twrp-12
KERNEL_CONFIG=vendor/wayne_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
KERNEL_NAME=

# Newer clang does not build 4.x trees reliably.
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
# kprobes is unreliable on 4.x; manual hooks are patched into the syscall
# entry points instead.
KSU_HOOK_MODE=manual
ENABLE_KPM=false

ENABLE_SUSFS=true
SUSFS_BRANCH=auto

# 4.19 predates path_umount() (added in 5.9), so KernelSU cannot unmount its
# own mounts without this.
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true

ADD_OVERLAYFS_CONFIG=true
ADD_KPROBES_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
