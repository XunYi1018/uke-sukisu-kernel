# Example: modern GKI kernel (Android 15, Linux 6.6) built from source.
#
# Run it with:  Actions -> Build Kernel -> Config file to build =
#               config/gki-android15-6.6.env
#
# This builds the GKI source tree with plain `make`, producing a source-
# integrated kernel. It is not the Bazel/Kleaf flow and does not produce a
# signed GKI release image.

CONFIG_ENV=config/gki-android15-6.6.env

KERNEL_SOURCE=https://github.com/aosp-mirror/kernel_common
KERNEL_SOURCE_BRANCH=android15-6.6
KERNEL_CONFIG=gki_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=

# 6.6 builds cleanly with a current toolchain and full LLVM.
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379
USE_LLVM=true
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
EXTRA_CMDS:
CUSTOM_CMDS:

# SukiSU-Ultra's main branch is the modular v4 tree and supports KPM.
KSU_VARIANT=sukisu-ultra
KSU_REF=main
KSU_HOOK_MODE=auto
ENABLE_KPM=true

# SUSFS_BRANCH=auto resolves 6.6 to gki-android15-6.6.
ENABLE_SUSFS=true
SUSFS_BRANCH=auto

# path_umount is already upstream in 6.6; leaving this on is harmless (the
# step detects it and skips) but there is no reason to enable it.
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false

ADD_OVERLAYFS_CONFIG=true
ADD_KPROBES_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=false
EXTRA_DEFCONFIG=CONFIG_TMPFS_XATTR=y CONFIG_TMPFS_POSIX_ACL=y

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
