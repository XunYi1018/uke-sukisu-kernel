# Xiaomi Pad 7 (uke) -- SukiSU-Ultra + SUSFS
#
# Kernel source: Xiaomi's own open-source tree for uke (Android 15, Linux 6.1.68).
# A generic Google GKI kernel cannot boot this device because CONFIG_MODVERSIONS=y
# ties the vendor modules' symbol CRCs to Xiaomi's own build; compiling Xiaomi's
# tree keeps those CRCs compatible.
#
# configs/uke_gki_defconfig is the exact .config extracted from the stock
# OS3.0.306.0.WOZCNXM boot.img (IKCONFIG), so the resulting kernel matches the
# shipping configuration rather than a generic GKI default.

CONFIG_ENV=config/uke.env

KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=uke-v-oss
KERNEL_CONFIG=uke_gki_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=uke

# Stock kernel was built with clang 17.0.2 (r487747c). r510928 is the closest
# published AOSP toolchain in this action's catalogue.
CLANG_BRANCH=main-kernel-build-2024
CLANG_VERSION=r510928
USE_LLVM=true
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
EXTRA_CMDS:
CUSTOM_CMDS:

# SukiSU-Ultra "builtin" ships KernelSU+SUSFS integrated in-tree.
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=auto

ENABLE_SUSFS=true
SUSFS_BRANCH=auto

ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

ADD_OVERLAYFS_CONFIG=true
ADD_KPROBES_CONFIG=false
DISABLE_LTO=true
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=CONFIG_TMPFS_XATTR=y CONFIG_TMPFS_POSIX_ACL=y

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
